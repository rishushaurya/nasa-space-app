# Homeward | .env.example | v1.0.0 | 2026-10-29
# Copy to .env.local for local development; set the same names in Vercel for production.
# All free tiers; no credit card needed. Leave a key empty to skip that provider.
# Server only. Never prefix with VITE_.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openrouter/free
ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app
# Salt for the 3-byte IP hash in logs (rate limiting keys on it). Any random string.
IP_SALT=replace-me
